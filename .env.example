# CC-Proxy 环境变量模板
# 复制为 .env 后填入真实值(.env 已被 gitignore,不会进仓库)

# 上游 New-API 聚合网关基址(必填)
NEW_API_BASE_URL=https://your-new-api.com

# 上游 key(必填,仅代理内部持有,客户端永远不知道)
NEW_API_KEY=sk-your-upstream-key

# 代理对外唯一 key(必填,客户端 / Claude Code 和管理 API 都用它)
PROXY_KEY=sk-your-proxy-key

# DEBUG 请求日志(可选:1/true/yes 开启,false 关闭)。开启后每次启动生成 logs/<启动时间>.log
# 记录收到的请求、转发给上游的请求(Authorization 脱敏,body 截断)与响应状态/耗时
# DEBUG=true
