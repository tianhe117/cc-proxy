# CC-Proxy 环境变量
# 复制为 .env 后填入真实值

# 上游网关基址
NEW_API_BASE_URL=https://your-new-api.com

# 上游 API Key
NEW_API_KEY=sk-your-upstream-key

# 代理访问 Key(逗号分隔,每个 key 独立维护自己的 model)
PROXY_KEY=sk-key-aaa,sk-key-bbb

# 调试日志(可选,取消注释开启)
# DEBUG=true

# 跳过上游 HTTPS 证书校验(可选,用于自签名证书的上游,不安全,仅建议测试环境)
# UPSTREAM_SKIP_SSL_VERIFY=true
